[gd_resource type="OpenXRActionMap" load_steps=29 format=3]

[sub_resource type="OpenXRAction" id="OpenXRAction_default_pose"]
resource_name = "aim_pose"
localized_name = "Aim pose"
action_type = 3
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_grip_pose"]
resource_name = "grip_pose"
localized_name = "Grip pose"
action_type = 3
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_ui_click"]
resource_name = "ui_click"
localized_name = "UI click"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/right")

[sub_resource type="OpenXRActionSet" id="OpenXRActionSet_main"]
resource_name = "main"
localized_name = "Main action set"
actions = [SubResource("OpenXRAction_default_pose"), SubResource("OpenXRAction_grip_pose"), SubResource("OpenXRAction_ui_click")]

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_simple_left"]
action = SubResource("OpenXRAction_default_pose")
binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_simple_right"]
action = SubResource("OpenXRAction_default_pose")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_simple_grip_left"]
action = SubResource("OpenXRAction_grip_pose")
binding_path = "/user/hand/left/input/grip/pose"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_simple_grip_right"]
action = SubResource("OpenXRAction_grip_pose")
binding_path = "/user/hand/right/input/grip/pose"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_simple_ui_click"]
action = SubResource("OpenXRAction_ui_click")
binding_path = "/user/hand/right/input/select/click"

[sub_resource type="OpenXRInteractionProfile" id="OpenXRInteractionProfile_simple"]
interaction_profile_path = "/interaction_profiles/khr/simple_controller"
bindings = [SubResource("OpenXRIPBinding_simple_left"), SubResource("OpenXRIPBinding_simple_right"), SubResource("OpenXRIPBinding_simple_grip_left"), SubResource("OpenXRIPBinding_simple_grip_right"), SubResource("OpenXRIPBinding_simple_ui_click")]

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_touch_left"]
action = SubResource("OpenXRAction_default_pose")
binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_touch_right"]
action = SubResource("OpenXRAction_default_pose")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_touch_grip_left"]
action = SubResource("OpenXRAction_grip_pose")
binding_path = "/user/hand/left/input/grip/pose"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_touch_grip_right"]
action = SubResource("OpenXRAction_grip_pose")
binding_path = "/user/hand/right/input/grip/pose"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_touch_ui_click"]
action = SubResource("OpenXRAction_ui_click")
binding_path = "/user/hand/right/input/trigger/value"

[sub_resource type="OpenXRInteractionProfile" id="OpenXRInteractionProfile_touch"]
