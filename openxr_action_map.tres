bindings = [SubResource("OpenXRIPBinding_touch_left"), SubResource("OpenXRIPBinding_touch_right"), SubResource("OpenXRIPBinding_touch_grip_left"), SubResource("OpenXRIPBinding_touch_grip_right"), SubResource("OpenXRIPBinding_touch_ui_click")]

